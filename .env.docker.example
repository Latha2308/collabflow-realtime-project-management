# Docker Compose Environment Variables
# Copy this file to .env.docker and customize for your environment

# PostgreSQL Configuration
POSTGRES_USER=collabflow
POSTGRES_PASSWORD=collabflow_dev_password
POSTGRES_DB=collabflow_db

# Backend Configuration
SECRET_KEY=your_secret_key_at_least_32_characters_long_change_in_production
ENVIRONMENT=development

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5174,http://localhost:3000,http://frontend:5173,http://playwright:5173

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8001
VITE_WS_BASE_URL=ws://localhost:8001
