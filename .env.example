# =============================================================================
# CollabFlow Environment Configuration
# =============================================================================
# Copy this file to .env and configure with your actual values
# NEVER commit .env files to version control
#
# This file provides configuration for the entire Docker Compose stack

# -----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# -----------------------------------------------------------------------------

# Database user (default is fine for most deployments)
POSTGRES_USER=collabflow

# Database password
# REQUIRED for production - generate with: openssl rand -base64 32
# Development: Use any password
# Production: MUST be strong random password (minimum 20 characters)
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD

# Database name
POSTGRES_DB=collabflow_db

# -----------------------------------------------------------------------------
# Backend Application Configuration
# -----------------------------------------------------------------------------

# JWT Secret Key - Used to sign authentication tokens
# CRITICAL: This must be unique, random, and kept secret
#
# Generate secure value:
#   openssl rand -base64 64
#
# Production Requirements:
#   - Minimum 64 characters
#   - Cryptographically random
#   - Never reuse across environments
#   - Never commit to version control
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_VALUE_MIN_64_CHARS

# Application Environment
# Options: development, staging, production
# Production mode enforces security validation of secrets
ENVIRONMENT=development

# CORS Allowed Origins (comma-separated)
# Development: http://localhost:5173,http://localhost:3000
# Production: https://your-domain.com (use your actual domain)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------

# Backend API Base URL
# Development: http://localhost:8001 (Docker Compose maps backend to 8001)
# Production: https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8001

# WebSocket Base URL
# Development: ws://localhost:8001
# Production: wss://api.your-domain.com
VITE_WS_BASE_URL=ws://localhost:8001
