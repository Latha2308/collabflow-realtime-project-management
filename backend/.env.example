# =============================================================================
# CollabFlow Backend Environment Configuration
# =============================================================================
# Copy this file to backend/.env for local development
# For Docker Compose, use root .env file instead

# -----------------------------------------------------------------------------
# Database Connection
# -----------------------------------------------------------------------------

# PostgreSQL Connection String
# Format: postgresql://username:password@host:port/database
#
# Development (local): postgresql://collabflow:yourpassword@localhost:5432/collabflow_db
# Development (Docker): Use postgres as host: postgresql://collabflow:yourpassword@postgres:5432/collabflow_db
# Production: Use strong random password (minimum 20 characters)
DATABASE_URL=postgresql://collabflow:CHANGE_THIS_PASSWORD@localhost:5432/collabflow_db

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------

# Secret key for signing JWT tokens
# Generate with: openssl rand -base64 64
#
# Production Requirements:
#   - Minimum 64 characters
#   - Cryptographically random
#   - Never reuse across environments
SECRET_KEY=CHANGE_THIS_TO_SECURE_RANDOM_VALUE_MIN_64_CHARS

# JWT algorithm (do not change unless you know what you're doing)
ALGORITHM=HS256

# JWT token expiration in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------

# Environment: development, staging, production
# Production mode enforces security validation
ENVIRONMENT=development

# CORS allowed origins (comma-separated)
# Development: http://localhost:5173,http://localhost:3000
# Production: https://your-domain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Cookie Security (auto-configured based on ENVIRONMENT)
# -----------------------------------------------------------------------------

# Development: COOKIE_SECURE=false, COOKIE_SAMESITE=lax
# Production: COOKIE_SECURE=true, COOKIE_SAMESITE=strict
# Override only if needed:
# COOKIE_SECURE=true
# COOKIE_SAMESITE=strict
# COOKIE_MAX_AGE=604800
