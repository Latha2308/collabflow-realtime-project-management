# =============================================================================
# CollabFlow Frontend Environment Configuration
# =============================================================================
# Copy this file to frontend/.env for local development

# Backend API Base URL
# Development: http://localhost:8001 (Docker Compose maps backend to port 8001)
# Production: https://api.your-domain.com
VITE_API_BASE_URL=http://localhost:8001

# WebSocket Base URL
# Development: ws://localhost:8001
# Production: wss://api.your-domain.com
VITE_WS_BASE_URL=ws://localhost:8001
